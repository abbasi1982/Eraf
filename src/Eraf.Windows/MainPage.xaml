<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Eraf.Windows.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Eraf.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Ribbon look: big icon over a short label. -->
        <Style x:Key="RibbonButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="78" />
            <Setter Property="Height" Value="76" />
            <Setter Property="Padding" Value="4,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
        <Style x:Key="RibbonAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Width" Value="78" />
            <Setter Property="Height" Value="76" />
            <Setter Property="Padding" Value="4,6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
        <Style x:Key="RibbonToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="Width" Value="78" />
            <Setter Property="Height" Value="76" />
            <Setter Property="Padding" Value="4,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
        <Style x:Key="RibbonIcon" TargetType="FontIcon">
            <Setter Property="FontFamily" Value="{StaticResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RibbonLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RibbonGroupLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RibbonDivider" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="84" />
            <Setter Property="Margin" Value="6,4" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>
    </Page.Resources>

    <Grid Background="Transparent" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Ribbon: tabs on top, the commands of the chosen tab below. -->
        <StackPanel Grid.Row="0" Background="{ThemeResource LayerFillColorDefaultBrush}" AutomationProperties.AutomationId="Ribbon" AutomationProperties.Name="Ribbon">
            <SelectorBar
                x:Name="RibbonTabs"
                Margin="8,2,8,0"
                SelectionChanged="OnRibbonTabChanged"
                AutomationProperties.AutomationId="RibbonTabs"
                AutomationProperties.Name="Ribbon tabs">
                <SelectorBarItem x:Name="TabHome" Text="Home" IsSelected="True" AutomationProperties.AutomationId="TabHome" />
                <SelectorBarItem x:Name="TabVoice" Text="Voice note" AutomationProperties.AutomationId="TabVoice" />
                <SelectorBarItem x:Name="TabView" Text="View" AutomationProperties.AutomationId="TabView" />
            </SelectorBar>
            <ScrollViewer
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Auto"
                VerticalScrollMode="Disabled"
                Padding="8,0,8,4">
                <StackPanel Orientation="Horizontal">
                <Grid>
                    <!-- Home: start something, select, save and export, settings. -->
                    <StackPanel x:Name="HomeTab" Orientation="Horizontal">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    x:Name="CaptureButton" Style="{StaticResource RibbonButtonStyle}" Click="OnCameraClick"
                                    ToolTipService.ToolTip="Use camera"
                                    AutomationProperties.AutomationId="CameraButton" AutomationProperties.Name="Use camera"
                                    AutomationProperties.HelpText="Show the camera and take a photo.">
                                    <StackPanel Spacing="4"><FontIcon Glyph="&#xE722;" Style="{StaticResource RibbonIcon}" /><TextBlock Text="Camera" Style="{StaticResource RibbonLabel}" /></StackPanel>
                                </Button>
                                <DropDownButton
                                    x:Name="ScreenshotButton" Width="88" Height="76" Padding="4,6" Background="Transparent" BorderThickness="0"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Top"
                                    ToolTipService.ToolTip="Take a screenshot to start an ERAF (Ctrl+Shift+F9 from anywhere)"
                                    AutomationProperties.AutomationId="ScreenshotButton" AutomationProperties.Name="Screenshot"
                                    AutomationProperties.HelpText="Take a screenshot of a region, the whole screen or one window and use it as the photo.">
                                    <StackPanel Spacing="4"><FontIcon Glyph="&#xE7F4;" Style="{StaticResource RibbonIcon}" /><TextBlock Text="Screenshot" Style="{StaticResource RibbonLabel}" /></StackPanel>
                                    <DropDownButton.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem x:Name="ShotRegionItem" Text="Region (drag to select)" Click="OnScreenshotRegionClick" AutomationProperties.AutomationId="ShotRegionItem" />
                                            <MenuFlyoutItem x:Name="ShotScreenItem" Text="Whole screen" Click="OnScreenshotScreenClick" AutomationProperties.AutomationId="ShotScreenItem" />
                                            <MenuFlyoutItem x:Name="ShotWindowItem" Text="A window..." Click="OnScreenshotWindowClick" AutomationProperties.AutomationId="ShotWindowItem" />
                                        </MenuFlyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                                <Button
                                    x:Name="PasteButton" Style="{StaticResource RibbonButtonStyle}" Click="OnPasteClick"
                                    ToolTipService.ToolTip="Use the picture on the clipboard as the photo (Ctrl+V)"
                                    AutomationProperties.AutomationId="PasteButton" AutomationProperties.Name="Paste picture"
                                    AutomationProperties.HelpText="Use the picture (or the photo files) on the clipboard to start an ERAF.">
                                    <StackPanel Spacing="4"><FontIcon Glyph="&#xE77F;" Style="{StaticResource RibbonIcon}" /><TextBlock Text="Paste" Style="{StaticResource RibbonLabel}" /></StackPanel>
                                </Button>
                                <Button
                                    x:Name="ImportButton" Style="{StaticResource RibbonButtonStyle}" Click="OnImportClick"
                                    ToolTipService.ToolTip="Import image from anywhere (Ctrl+I)"
                                    AutomationProperties.AutomationId="ImportButton" AutomationProperties.Name="Import image"
                                    AutomationProperties.HelpText="Choose a photo file from any folder.">
                                    <StackPanel Spacing="4"><FontIcon Glyph="&#xE8B9;" Style="{StaticResource RibbonIcon}" /><TextBlock Text="Import image" Style="{StaticResource RibbonLabel}" /></StackPanel>
                                </Button>
                                <Button
                                    x:Name="OpenFileButton" Style="{StaticResource RibbonButtonStyle}" Click="OnOpenFileClick"
                                    ToolTipService.ToolTip="Open ERAF file from anywhere (Ctrl+O)"
                                    AutomationProperties.AutomationId="OpenFileButton" AutomationProperties.Name="Open ERAF file"
                                    AutomationProperties.HelpText="Choose a saved ERAF file from any folder.">
                                    <StackPanel Spacing="4"><FontIcon Glyph="&#xE8E5;" Style="{StaticResource RibbonIcon}" /><TextBlock Text="Open ERAF" Style="{StaticResource RibbonLabel}" /></StackPanel>
                                </Button>
                                <Button
                                    x:Name="MakeErafButton" Style="{StaticResource RibbonAccentButtonStyle}" Click="OnMakeErafClick"
                                    ToolTipService.ToolTip="Add a voice note to the selected photos or folders and save ERAF files (Ctrl+M)"
                                    AutomationProperties.AutomationId="MakeErafButton" AutomationProperties.Name="Make ERAF from selection"
                                    AutomationProperties.HelpText="Select photos or folders in the list first. You can then record or attach one voice note and save everything as ERAF files.">
                                    <StackPanel Spacing="4"><FontIcon Glyph="&#xE720;" Style="{StaticResource RibbonIcon}" /><TextBlock Text="Make ERAF" Style="{StaticResource RibbonLabel}" /></StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Start" Style="{StaticResource RibbonGroupLabel}" />
                        </StackPanel>
                        <Rectangle Style="{StaticResource RibbonDivider}" />
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    x:Name="SelectAllButton" Style="{StaticResource RibbonButtonStyle}" Click="OnSelectAllClick"
                                    ToolTipService.ToolTip="Select every item in the list"
                                    AutomationProperties.AutomationId="SelectAllButton" AutomationProperties.Name="Select all"
                                    AutomationProperties.HelpText="Select every item in this folder.">
                                    <StackPanel Spacing="4"><FontIcon Glyph="&#xE8B3;" Style="{StaticResource RibbonIcon}" /><TextBlock Text="Select all" Style="{StaticResource RibbonLabel}" /></StackPanel>
                                </Button>
                                <Button
                                    x:Name="SelectNoneButton" Style="{StaticResource RibbonButtonStyle}" Click="OnSelectNoneClick"
                                    ToolTipService.ToolTip="Clear the selection"
                                    AutomationProperties.AutomationId="SelectNoneButton" AutomationProperties.Name="Select none"
                                    AutomationProperties.HelpText="Clear the selection.">
                                    <StackPanel Spacing="4"><FontIcon Glyph="&#xE894;" Style="{StaticResource RibbonIcon}" /><TextBlock Text="Select none" Style="{StaticResource RibbonLabel}" /></StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Select" Style="{StaticResource RibbonGroupLabel}" />
                        </StackPanel>
                        <Rectangle Style="{StaticResource RibbonDivider}" />
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    x:Name="SettingsButton" Style="{StaticResource RibbonButtonStyle}" Click="OnSettingsClick"
                                    ToolTipService.ToolTip="Theme, folder scanning and batch options"
                                    AutomationProperties.AutomationId="SettingsButton" AutomationProperties.Name="Settings"
                                    AutomationProperties.HelpText="Open the Settings page.">
                                    <StackPanel Spacing="4"><FontIcon Glyph="&#xE713;" Style="{StaticResource RibbonIcon}" /><TextBlock Text="Settings" Style="{StaticResource RibbonLabel}" /></StackPanel>
                                </Button>
                                <Button
                                    x:Name="AboutButton" Style="{StaticResource RibbonButtonStyle}" Click="OnAboutClick"
                                    ToolTipService.ToolTip="About ERAF"
                                    AutomationProperties.AutomationId="AboutButton" AutomationProperties.Name="About ERAF"
                                    AutomationProperties.HelpText="Show what ERAF is.">
                                    <StackPanel Spacing="4"><FontIcon Glyph="&#xE946;" Style="{StaticResource RibbonIcon}" /><TextBlock Text="About" Style="{StaticResource RibbonLabel}" /></StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="App" Style="{StaticResource RibbonGroupLabel}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Voice note: record, play, bring in or cut an audio file, choose the microphone. -->
                    <StackPanel x:Name="VoiceTab" Orientation="Horizontal" Visibility="Collapsed">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    x:Name="RecordButton" Style="{StaticResource RibbonAccentButtonStyle}" Click="OnRecordClick"
                                    ToolTipService.ToolTip="Record a voice note (Ctrl+R)"
                                    AutomationProperties.AutomationId="RecordButton" AutomationProperties.Name="Record voice note"
                                    AutomationProperties.HelpText="Start recording from the microphone. If there is already a voice note, the new one replaces it.">
                                    <StackPanel Spacing="4"><FontIcon Glyph="&#xE720;" Style="{StaticResource RibbonIcon}" /><TextBlock x:Name="RecordLabel" Text="Record" Style="{StaticResource RibbonLabel}" /></StackPanel>
                                </Button>
                                <Button
                                    x:Name="StopRecordButton" Style="{StaticResource RibbonButtonStyle}" Click="OnStopRecordClick" IsEnabled="False"
                                    ToolTipService.ToolTip="Stop recording"
                                    AutomationProperties.AutomationId="StopRecordButton" AutomationProperties.Name="Stop recording"
                                    AutomationProperties.HelpText="Finish the voice note.">
                                    <StackPanel Spacing="4"><FontIcon Glyph="&#xE71A;" Style="{StaticResource RibbonIcon}" /><TextBlock Text="Stop" Style="{StaticResource RibbonLabel}" /></StackPanel>
                                </Button>
                                <Button
                                    x:Name="PlayButton" Style="{StaticResource RibbonButtonStyle}" Click="OnPlayClick" IsEnabled="False"
                                    ToolTipService.ToolTip="Play or stop the voice note"
                                    AutomationProperties.AutomationId="PlayButton"
                                    AutomationProperties.HelpText="Play or stop the voice note.">
                                    <StackPanel Spacing="4"><FontIcon x:Name="PlayGlyph" Glyph="&#xE768;" Style="{StaticResource RibbonIcon}" /><TextBlock x:Name="PlayLabel" Text="Play" Style="{StaticResource RibbonLabel}" /></StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Record and listen" Style="{StaticResource RibbonGroupLabel}" />
                        </StackPanel>
                        <Rectangle Style="{StaticResource RibbonDivider}" />
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    x:Name="AttachAudioButton" Style="{StaticResource RibbonButtonStyle}" Click="OnAttachAudioClick" IsEnabled="False"
                                    ToolTipService.ToolTip="Use a saved audio file as the voice note"
                                    AutomationProperties.AutomationId="AttachAudioButton" AutomationProperties.Name="Attach audio file"
                                    AutomationProperties.HelpText="Use a saved audio file (M4A, MP3, WAV and others) as the voice note instead of recording. It replaces any voice note you already have.">
                                    <StackPanel Spacing="4"><FontIcon Glyph="&#xE723;" Style="{StaticResource RibbonIcon}" /><TextBlock Text="Attach audio" Style="{StaticResource RibbonLabel}" /></StackPanel>
                                </Button>
                                <Button
                                    x:Name="TrimButton" Style="{StaticResource RibbonButtonStyle}" Click="OnTrimClick" IsEnabled="False"
                                    ToolTipService.ToolTip="Cut the start or end off the voice note (Ctrl+T)"
                                    AutomationProperties.AutomationId="TrimButton" AutomationProperties.Name="Trim voice note"
                                    AutomationProperties.HelpText="Cut the start or end off the voice note.">
                                    <StackPanel Spacing="4"><FontIcon Glyph="&#xE8C6;" Style="{StaticResource RibbonIcon}" /><TextBlock Text="Trim" Style="{StaticResource RibbonLabel}" /></StackPanel>
                                </Button>
                                <Button
                                    x:Name="DeleteVoiceButton" Style="{StaticResource RibbonButtonStyle}" Click="OnDeleteVoiceClick" IsEnabled="False"
                                    ToolTipService.ToolTip="Remove the voice note"
                                    AutomationProperties.AutomationId="DeleteVoiceButton" AutomationProperties.Name="Discard voice note"
                                    AutomationProperties.HelpText="Remove the voice note so a new one can be recorded.">
                                    <StackPanel Spacing="4"><FontIcon Glyph="&#xE74D;" Style="{StaticResource RibbonIcon}" /><TextBlock Text="Discard" Style="{StaticResource RibbonLabel}" /></StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Audio file" Style="{StaticResource RibbonGroupLabel}" />
                        </StackPanel>
                        <Rectangle Style="{StaticResource RibbonDivider}" />
                        <StackPanel>
                            <ComboBox
                                x:Name="MicrophoneCombo"
                                Width="260"
                                Margin="4,22,4,0"
                                DisplayMemberPath="Name"
                                AutomationProperties.AutomationId="MicrophoneCombo"
                                AutomationProperties.Name="Microphone"
                                AutomationProperties.HelpText="Choose which microphone records the voice note."
                                DropDownOpened="OnMicrophoneDropDownOpened"
                                SelectionChanged="OnMicrophoneSelectionChanged" />
                            <TextBlock Text="Microphone" Style="{StaticResource RibbonGroupLabel}" Margin="0,22,0,0" />
                        </StackPanel>
                        <!-- Shown while no photo is open, to say why the buttons are grey and what to do. -->
                        <TextBlock
                            x:Name="VoiceHint"
                            Margin="16,0,0,0"
                            MaxWidth="360"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap"
                            Opacity="0.85"
                            Text="These buttons need a photo. Tick a photo (or an ERAF file) in the list and press Make ERAF on the Home tab; then record, attach or trim the voice note here."
                            AutomationProperties.AutomationId="VoiceHint"
                            AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>

                    <!-- View: checkboxes, subfolder search, theme. -->
                    <StackPanel x:Name="ViewTab" Orientation="Horizontal" Visibility="Collapsed">
                        <StackPanel>
                            <ComboBox
                                x:Name="ViewModeBox"
                                Width="170"
                                Margin="4,22,4,0"
                                SelectionChanged="OnViewModeBoxChanged"
                                AutomationProperties.AutomationId="ViewModeBox"
                                AutomationProperties.Name="Layout"
                                AutomationProperties.HelpText="Show files as Details, Tiles, Small, Medium or Large icons, or a List. Shortcuts Ctrl+Shift+2 to 7." />
                            <TextBlock Text="Layout" Style="{StaticResource RibbonGroupLabel}" Margin="0,22,0,0" />
                        </StackPanel>
                        <Rectangle Style="{StaticResource RibbonDivider}" />
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton
                                    x:Name="CheckboxToggle" Style="{StaticResource RibbonToggleStyle}" Click="OnCheckboxToggleClick"
                                    ToolTipService.ToolTip="Show a checkbox next to every file and folder"
                                    AutomationProperties.AutomationId="CheckboxToggle" AutomationProperties.Name="Show checkboxes"
                                    AutomationProperties.HelpText="Show a checkbox next to every file and folder so several can be ticked.">
                                    <StackPanel Spacing="4"><FontIcon Glyph="&#xE73A;" Style="{StaticResource RibbonIcon}" /><TextBlock Text="Checkboxes" Style="{StaticResource RibbonLabel}" /></StackPanel>
                                </ToggleButton>
                                <ToggleButton
                                    x:Name="SubfoldersToggle" Style="{StaticResource RibbonToggleStyle}" Click="OnSubfoldersToggleClick"
                                    ToolTipService.ToolTip="Also look in the subfolders when a folder is selected"
                                    AutomationProperties.AutomationId="SubfoldersToggle" AutomationProperties.Name="Search subfolders"
                                    AutomationProperties.HelpText="When a folder is selected for Make ERAF, also look in the folders inside it.">
                                    <StackPanel Spacing="4"><FontIcon Glyph="&#xE8B7;" Style="{StaticResource RibbonIcon}" /><TextBlock Text="Subfolders" Style="{StaticResource RibbonLabel}" /></StackPanel>
                                </ToggleButton>
                            </StackPanel>
                            <TextBlock Text="Selection" Style="{StaticResource RibbonGroupLabel}" />
                        </StackPanel>
                        <Rectangle Style="{StaticResource RibbonDivider}" />
                        <StackPanel>
                            <ComboBox
                                x:Name="ThemeBox"
                                Width="230"
                                Margin="4,22,4,0"
                                SelectionChanged="OnThemeBoxChanged"
                                AutomationProperties.AutomationId="ThemeBox"
                                AutomationProperties.Name="Theme"
                                AutomationProperties.HelpText="Choose the colours of the app, or follow Windows." />
                            <TextBlock Text="Theme" Style="{StaticResource RibbonGroupLabel}" Margin="0,22,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                        <Rectangle Style="{StaticResource RibbonDivider}" />
                        <StackPanel x:Name="FileGroup">
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    x:Name="SaveButton" Style="{StaticResource RibbonAccentButtonStyle}" Click="OnSaveClick" IsEnabled="False"
                                    ToolTipService.ToolTip="Save the photo and voice note as an ERAF file (Ctrl+S)"
                                    AutomationProperties.AutomationId="SaveButton" AutomationProperties.Name="Save ERAF file"
                                    AutomationProperties.HelpText="Save the photo and voice note as one ERAF file. Available when both are present.">
                                    <StackPanel Spacing="4"><FontIcon Glyph="&#xE74E;" Style="{StaticResource RibbonIcon}" /><TextBlock x:Name="SaveLabel" Text="Save ERAF" Style="{StaticResource RibbonLabel}" /></StackPanel>
                                </Button>
                                <Button
                                    x:Name="ExportPhotoButton" Style="{StaticResource RibbonButtonStyle}" Click="OnExportPhotoClick"
                                    ToolTipService.ToolTip="Save the photo alone as a JPEG file"
                                    AutomationProperties.AutomationId="ExportPhotoButton" AutomationProperties.Name="Export photo"
                                    AutomationProperties.HelpText="Save the photo alone as a JPEG file.">
                                    <StackPanel Spacing="4"><FontIcon Glyph="&#xE91B;" Style="{StaticResource RibbonIcon}" /><TextBlock Text="Export photo" Style="{StaticResource RibbonLabel}" /></StackPanel>
                                </Button>
                                <Button
                                    x:Name="ExportAudioButton" Style="{StaticResource RibbonButtonStyle}" Click="OnExportAudioClick"
                                    ToolTipService.ToolTip="Save the voice note alone as an M4A file"
                                    AutomationProperties.AutomationId="ExportAudioButton" AutomationProperties.Name="Export voice note"
                                    AutomationProperties.HelpText="Save the voice note alone as an M4A file.">
                                    <StackPanel Spacing="4"><FontIcon Glyph="&#xE8D6;" Style="{StaticResource RibbonIcon}" /><TextBlock Text="Export voice" Style="{StaticResource RibbonLabel}" /></StackPanel>
                                </Button>
                                <Button
                                    x:Name="DiscardButton" Style="{StaticResource RibbonButtonStyle}" Click="OnDiscardClick"
                                    ToolTipService.ToolTip="Close this photo and go back to the file list"
                                    AutomationProperties.AutomationId="DiscardButton" AutomationProperties.Name="Back to files"
                                    AutomationProperties.HelpText="Close this photo and voice note and go back to the file list. Asks first if they are not saved.">
                                    <StackPanel Spacing="4"><FontIcon Glyph="&#xE8B7;" Style="{StaticResource RibbonIcon}" /><TextBlock Text="Back to files" Style="{StaticResource RibbonLabel}" /></StackPanel>
                                </Button>
                                <Button
                                    x:Name="DismissErrorButton" Style="{StaticResource RibbonButtonStyle}" Click="OnDismissErrorClick" IsEnabled="False"
                                    ToolTipService.ToolTip="Close the save error and keep working"
                                    AutomationProperties.AutomationId="DismissErrorButton" AutomationProperties.Name="OK, dismiss save error"
                                    AutomationProperties.HelpText="Close the error and keep working with the photo and voice note.">
                                    <StackPanel Spacing="4"><FontIcon Glyph="&#xE10B;" Style="{StaticResource RibbonIcon}" /><TextBlock Text="Dismiss error" Style="{StaticResource RibbonLabel}" /></StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Photo and file" Style="{StaticResource RibbonGroupLabel}" />
                        </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>

        <!-- Path bar: where you are, and a name filter. -->
        <Grid Grid.Row="1" Padding="12,8" ColumnSpacing="6" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="BackNavButton" Grid.Column="0" Width="40" Height="36" Padding="0"
                Click="OnBackNavClick"
                ToolTipService.ToolTip="Back (Alt+Left)"
                AutomationProperties.AutomationId="BackNavButton"
                AutomationProperties.Name="Back"
                AutomationProperties.HelpText="Go to the previous folder.">
                <FontIcon Glyph="&#xE72B;" FontFamily="{StaticResource SymbolThemeFontFamily}" />
            </Button>
            <Button
                x:Name="ForwardNavButton" Grid.Column="1" Width="40" Height="36" Padding="0"
                Click="OnForwardNavClick"
                ToolTipService.ToolTip="Forward (Alt+Right)"
                AutomationProperties.AutomationId="ForwardNavButton"
                AutomationProperties.Name="Forward"
                AutomationProperties.HelpText="Go to the next folder.">
                <FontIcon Glyph="&#xE72A;" FontFamily="{StaticResource SymbolThemeFontFamily}" />
            </Button>
            <Button
                x:Name="UpNavButton" Grid.Column="2" Width="40" Height="36" Padding="0"
                Click="OnUpNavClick"
                ToolTipService.ToolTip="Up one folder (Alt+Up)"
                AutomationProperties.AutomationId="UpNavButton"
                AutomationProperties.Name="Up one folder"
                AutomationProperties.HelpText="Go to the folder that contains this one.">
                <FontIcon Glyph="&#xE74A;" FontFamily="{StaticResource SymbolThemeFontFamily}" />
            </Button>
            <Button
                x:Name="RefreshNavButton" Grid.Column="3" Width="40" Height="36" Padding="0"
                Click="OnRefreshNavClick"
                ToolTipService.ToolTip="Refresh (F5)"
                AutomationProperties.AutomationId="RefreshNavButton"
                AutomationProperties.Name="Refresh"
                AutomationProperties.HelpText="Read this folder again.">
                <FontIcon Glyph="&#xE72C;" FontFamily="{StaticResource SymbolThemeFontFamily}" />
            </Button>

            <TextBox
                x:Name="AddressBox" Grid.Column="4"
                PlaceholderText="Type a folder path and press Enter"
                KeyDown="OnAddressKeyDown"
                AutomationProperties.AutomationId="AddressBox"
                AutomationProperties.Name="Folder path"
                AutomationProperties.HelpText="The folder being shown. Type another path and press Enter to go there." />
            <TextBox
                x:Name="FilterBox" Grid.Column="5"
                PlaceholderText="Filter by name"
                TextChanged="OnFilterChanged"
                AutomationProperties.AutomationId="FilterBox"
                AutomationProperties.Name="Filter by name"
                AutomationProperties.HelpText="Show only the items in this folder whose name contains what you type." />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left blade: drives and folders. -->
            <Border
                Grid.Column="0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
                <local:PlacesBlade x:Name="Blade" />
            </Border>

            <!-- Right: the files of the current folder, or the photo and voice note being worked on. -->
            <Grid Grid.Column="1" Padding="16,8,16,16" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Shown while a big folder is being read. -->
                <ProgressBar
                    x:Name="FolderLoading"
                    Grid.Row="0"
                    IsIndeterminate="True"
                    Visibility="Collapsed"
                    AutomationProperties.AutomationId="FolderLoading"
                    AutomationProperties.Name="Reading the folder" />


                <local:FileListPane x:Name="FileList" x:FieldModifier="private" Grid.Row="1" />

                <!-- Live camera preview. -->
                <Grid x:Name="CameraPanel" Grid.Row="1" Visibility="Collapsed" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <MediaPlayerElement
                        x:Name="CameraPreview"
                        AutomationProperties.Name="Camera preview"
                        Grid.Row="0"
                        Stretch="Uniform"
                        AutoPlay="True"
                        AreTransportControlsEnabled="False" />
                    <StackPanel
                        Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="12"
                        HorizontalAlignment="Center">
                        <Button
                            x:Name="TakePhotoButton"
                            Content="Take photo"
                            AutomationProperties.AutomationId="TakePhotoButton"
                            AutomationProperties.Name="Take photo"
                            AutomationProperties.HelpText="Capture the photo shown by the camera."
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnTakePhotoClick" />
                        <Button
                            x:Name="CancelCameraButton"
                            Content="Cancel"
                            AutomationProperties.AutomationId="CancelCameraButton"
                            AutomationProperties.Name="Cancel camera"
                            AutomationProperties.HelpText="Close the camera without taking a photo. Shortcut: Escape."
                            Click="OnCancelCameraClick">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Escape" />
                            </Button.KeyboardAccelerators>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Photo preview of exactly the bytes held in the session. The commands live in the ribbon. -->
                <Grid x:Name="PhotoPanel" Grid.Row="1" Visibility="Collapsed" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Image
                        x:Name="PhotoImage"
                        Grid.Row="0"
                        Stretch="Uniform"
                        AutomationProperties.Name="Photo preview" />
                    <TextBlock
                        x:Name="PhotoInfo"
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        AutomationProperties.AutomationId="PhotoInfo" />

                    <StackPanel Grid.Row="2" Spacing="4" HorizontalAlignment="Center">
                        <!-- Recording in progress. -->
                        <StackPanel x:Name="RecordingPanel" Visibility="Collapsed" HorizontalAlignment="Center">
                            <TextBlock
                                x:Name="RecordingStatus"
                                HorizontalAlignment="Center"
                                AutomationProperties.AutomationId="RecordingStatus" />
                        </StackPanel>
                        <!-- A voice note is held in the session. -->
                        <StackPanel x:Name="VoicePanel" Visibility="Collapsed" HorizontalAlignment="Center">
                            <TextBlock
                                x:Name="VoiceInfo"
                                HorizontalAlignment="Center"
                                AutomationProperties.AutomationId="VoiceInfo" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Whether what is held is on disk: "Not saved yet", "Saving...", "Saved: name", or the error state. -->
                    <TextBlock
                        x:Name="SaveStatus"
                        Grid.Row="3"
                        HorizontalAlignment="Center"
                        AutomationProperties.AutomationId="SaveStatus" AutomationProperties.LiveSetting="Polite" />
                </Grid>

                <!-- Settings page: covers the file list and the editor while it is open. -->
                <local:SettingsPane x:Name="SettingsView" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" />
            </Grid>
        </Grid>

        <!-- Status bar: the latest message on the left (with a symbol, so colour is never the only hint), item counts on the right. -->
        <Grid
            x:Name="StatusBar"
            Grid.Row="3"
            Padding="12,4"
            ColumnSpacing="10"
            MinHeight="30"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            AutomationProperties.AutomationId="StatusBar"
            AutomationProperties.Name="Status bar">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon
                x:Name="StatusIcon"
                Grid.Column="0"
                FontFamily="{StaticResource SymbolThemeFontFamily}"
                FontSize="14"
                VerticalAlignment="Center"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="StatusMessage"
                Grid.Column="1"
                VerticalAlignment="Center"
                TextWrapping="Wrap"
                MaxLines="2"
                TextTrimming="CharacterEllipsis"
                AutomationProperties.AutomationId="StatusMessage"
                AutomationProperties.LiveSetting="Polite" />
            <Button
                x:Name="StatusActionButton"
                Grid.Column="2"
                Padding="10,2"
                Visibility="Collapsed"
                Click="OnStatusActionClick"
                AutomationProperties.AutomationId="StatusActionButton" />
            <Button
                x:Name="StatusDismissButton"
                Grid.Column="3"
                Width="28"
                Height="24"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Visibility="Collapsed"
                Click="OnStatusDismissClick"
                ToolTipService.ToolTip="Clear this message"
                AutomationProperties.AutomationId="StatusDismissButton"
                AutomationProperties.Name="Clear message">
                <FontIcon Glyph="&#xE711;" FontSize="10" FontFamily="{StaticResource SymbolThemeFontFamily}" />
            </Button>
            <TextBlock
                x:Name="StatusCounts"
                Grid.Column="4"
                VerticalAlignment="Center"
                Opacity="0.8"
                AutomationProperties.AutomationId="StatusCounts" />
        </Grid>
    </Grid>
</Page>
