<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Eraf.Windows.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Eraf.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar
            x:Name="MessageBar"
            Grid.Row="0"
            IsOpen="False"
            IsClosable="True"
            AutomationProperties.AutomationId="MessageBar"
            AutomationProperties.Name="Message"
            Severity="Error" />

        <!-- Idle: nothing chosen yet. -->
        <StackPanel
            x:Name="IdlePanel"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16">
            <TextBlock
                Text="Choose a photo"
                Style="{StaticResource TitleTextBlockStyle}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="Import an existing image, take one with the camera, or open an ERAF file."
                HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <Button
                    x:Name="ImportButton"
                    Content="Import image"
                    AutomationProperties.AutomationId="ImportButton"
                    AutomationProperties.Name="Import image"
                    AutomationProperties.HelpText="Choose a photo file from this computer."
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnImportClick" />
                <Button
                    x:Name="CaptureButton"
                    Content="Use camera"
                    AutomationProperties.AutomationId="CameraButton"
                    AutomationProperties.Name="Use camera"
                    AutomationProperties.HelpText="Show the camera and take a photo."
                    Click="OnCameraClick" />
                <Button
                    x:Name="OpenFileButton"
                    Content="Open ERAF file"
                    AutomationProperties.AutomationId="OpenFileButton"
                    AutomationProperties.Name="Open ERAF file"
                    AutomationProperties.HelpText="Open a saved ERAF file with a photo and voice note."
                    Click="OnOpenFileClick" />
            </StackPanel>
        </StackPanel>

        <!-- Live camera preview. -->
        <Grid x:Name="CameraPanel" Grid.Row="1" Visibility="Collapsed" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <MediaPlayerElement
                x:Name="CameraPreview"
                AutomationProperties.Name="Camera preview"
                Grid.Row="0"
                Stretch="Uniform"
                AutoPlay="True"
                AreTransportControlsEnabled="False" />
            <StackPanel
                Grid.Row="1"
                Orientation="Horizontal"
                Spacing="12"
                HorizontalAlignment="Center">
                <Button
                    x:Name="TakePhotoButton"
                    Content="Take photo"
                    AutomationProperties.AutomationId="TakePhotoButton"
                    AutomationProperties.Name="Take photo"
                    AutomationProperties.HelpText="Capture the photo shown by the camera."
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnTakePhotoClick" />
                <Button
                    x:Name="CancelCameraButton"
                    Content="Cancel"
                    AutomationProperties.AutomationId="CancelCameraButton"
                    AutomationProperties.Name="Cancel camera"
                    AutomationProperties.HelpText="Close the camera without taking a photo. Shortcut: Escape."
                    Click="OnCancelCameraClick">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Escape" />
                    </Button.KeyboardAccelerators>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Photo preview of exactly the bytes held in the session, with the voice note controls. -->
        <Grid x:Name="PhotoPanel" Grid.Row="1" Visibility="Collapsed" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Image
                x:Name="PhotoImage"
                Grid.Row="0"
                Stretch="Uniform"
                AutomationProperties.Name="Photo preview" />
            <TextBlock
                x:Name="PhotoInfo"
                Grid.Row="1"
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="PhotoInfo" />

            <StackPanel Grid.Row="2" Spacing="8" HorizontalAlignment="Center">
                <!-- Which microphone the next recording uses. Hidden while recording. -->
                <ComboBox
                    x:Name="MicrophoneCombo"
                    Header="Microphone"
                    MinWidth="280"
                    HorizontalAlignment="Center"
                    DisplayMemberPath="Name"
                    AutomationProperties.AutomationId="MicrophoneCombo"
                    AutomationProperties.Name="Microphone"
                    AutomationProperties.HelpText="Choose which microphone records the voice note."
                    DropDownOpened="OnMicrophoneDropDownOpened"
                    SelectionChanged="OnMicrophoneSelectionChanged" />

                <!-- No voice note yet. -->
                <Button
                    x:Name="RecordButton"
                    Content="Record voice note"
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="RecordButton"
                    AutomationProperties.Name="Record voice note"
                    AutomationProperties.HelpText="Start recording from the microphone."
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnRecordClick" />

                <Button
                    x:Name="AttachAudioButton"
                    Content="Attach audio file"
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="AttachAudioButton"
                    AutomationProperties.Name="Attach audio file"
                    AutomationProperties.HelpText="Use a saved audio file (M4A, MP3, WAV and others) as the voice note instead of recording."
                    Click="OnAttachAudioClick" />

                <!-- Recording in progress. -->
                <StackPanel x:Name="RecordingPanel" Spacing="8" Visibility="Collapsed" HorizontalAlignment="Center">
                    <TextBlock
                        x:Name="RecordingStatus"
                        HorizontalAlignment="Center"
                        AutomationProperties.AutomationId="RecordingStatus" />
                    <Button
                        x:Name="StopRecordButton"
                        Content="Stop recording"
                        HorizontalAlignment="Center"
                        AutomationProperties.AutomationId="StopRecordButton"
                        AutomationProperties.Name="Stop recording"
                        AutomationProperties.HelpText="Finish the voice note."
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnStopRecordClick" />
                </StackPanel>

                <!-- A voice note is held in the session. -->
                <StackPanel x:Name="VoicePanel" Spacing="8" Visibility="Collapsed" HorizontalAlignment="Center">
                    <TextBlock
                        x:Name="VoiceInfo"
                        HorizontalAlignment="Center"
                        AutomationProperties.AutomationId="VoiceInfo" AutomationProperties.LiveSetting="Polite" />
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <Button
                            x:Name="PlayButton"
                            Content="Play"
                            AutomationProperties.AutomationId="PlayButton"
                            AutomationProperties.HelpText="Play or stop the voice note."
                            Click="OnPlayClick" />
                        <Button
                            x:Name="RerecordButton"
                            Content="Record again"
                            AutomationProperties.AutomationId="RerecordButton"
                            AutomationProperties.Name="Record voice note again"
                            AutomationProperties.HelpText="Replace the current voice note with a new recording."
                            Click="OnRecordClick" />
                        <Button
                            x:Name="ReplaceAudioFileButton"
                            Content="Replace with audio file"
                            AutomationProperties.AutomationId="ReplaceAudioFileButton"
                            AutomationProperties.Name="Replace with audio file"
                            AutomationProperties.HelpText="Replace the voice note with a saved audio file."
                            Click="OnAttachAudioClick" />
                        <Button
                            x:Name="DeleteVoiceButton"
                            Content="Discard voice note"
                            AutomationProperties.AutomationId="DeleteVoiceButton"
                            AutomationProperties.Name="Discard voice note"
                            AutomationProperties.HelpText="Remove the voice note so a new one can be recorded."
                            Click="OnDeleteVoiceClick" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Whether what is held is on disk: "Not saved yet", "Saving...", "Saved: name", or the error state. -->
            <TextBlock
                x:Name="SaveStatus"
                Grid.Row="3"
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="SaveStatus" AutomationProperties.LiveSetting="Polite" />

            <StackPanel
                Grid.Row="4"
                Orientation="Horizontal"
                Spacing="12"
                HorizontalAlignment="Center">
                <!-- Enabled only in ReadyToSave (photo + valid voice note). -->
                <Button
                    x:Name="SaveButton"
                    Content="Save ERAF file"
                    IsEnabled="False"
                    AutomationProperties.AutomationId="SaveButton"
                    AutomationProperties.Name="Save ERAF file"
                    AutomationProperties.HelpText="Save the photo and voice note as one ERAF file. Available when both are present."
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnSaveClick" />
                <!-- Shown only after a failed save. The photo and voice note are still held. -->
                <Button
                    x:Name="DismissErrorButton"
                    Content="OK"
                    Visibility="Collapsed"
                    AutomationProperties.AutomationId="DismissErrorButton"
                    AutomationProperties.Name="OK, dismiss save error"
                    AutomationProperties.HelpText="Close the error and keep working with the photo and voice note."
                    Click="OnDismissErrorClick" />
            </StackPanel>

            <StackPanel
                Grid.Row="5"
                Orientation="Horizontal"
                Spacing="12"
                HorizontalAlignment="Center">
                <Button
                    x:Name="ExportPhotoButton"
                    Content="Export photo"
                    AutomationProperties.AutomationId="ExportPhotoButton"
                    AutomationProperties.Name="Export photo"
                    AutomationProperties.HelpText="Save the photo alone as a JPEG file."
                    Click="OnExportPhotoClick" />
                <Button
                    x:Name="ExportAudioButton"
                    Content="Export voice note"
                    AutomationProperties.AutomationId="ExportAudioButton"
                    AutomationProperties.Name="Export voice note"
                    AutomationProperties.HelpText="Save the voice note alone as an M4A file."
                    Click="OnExportAudioClick" />
                <Button
                    x:Name="DiscardButton"
                    Content="Start over"
                    AutomationProperties.AutomationId="DiscardButton"
                    AutomationProperties.Name="Start over"
                    AutomationProperties.HelpText="Remove the photo and voice note and return to the start. Asks first if they are not saved."
                    Click="OnDiscardClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
