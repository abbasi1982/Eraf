<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Eraf.Windows.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Eraf.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar
            x:Name="MessageBar"
            Grid.Row="0"
            IsOpen="False"
            IsClosable="True"
            Severity="Error" />

        <!-- Idle: nothing chosen yet. -->
        <StackPanel
            x:Name="IdlePanel"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16">
            <TextBlock
                Text="Choose a photo"
                Style="{StaticResource TitleTextBlockStyle}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="Import an existing image, or take one with the camera."
                HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <Button
                    x:Name="ImportButton"
                    Content="Import image"
                    AutomationProperties.AutomationId="ImportButton"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnImportClick" />
                <Button
                    x:Name="CaptureButton"
                    Content="Use camera"
                    AutomationProperties.AutomationId="CameraButton"
                    Click="OnCameraClick" />
            </StackPanel>
        </StackPanel>

        <!-- Live camera preview. -->
        <Grid x:Name="CameraPanel" Grid.Row="1" Visibility="Collapsed" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <MediaPlayerElement
                x:Name="CameraPreview"
                Grid.Row="0"
                Stretch="Uniform"
                AutoPlay="True"
                AreTransportControlsEnabled="False" />
            <StackPanel
                Grid.Row="1"
                Orientation="Horizontal"
                Spacing="12"
                HorizontalAlignment="Center">
                <Button
                    x:Name="TakePhotoButton"
                    Content="Take photo"
                    AutomationProperties.AutomationId="TakePhotoButton"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnTakePhotoClick" />
                <Button
                    x:Name="CancelCameraButton"
                    Content="Cancel"
                    AutomationProperties.AutomationId="CancelCameraButton"
                    Click="OnCancelCameraClick" />
            </StackPanel>
        </Grid>

        <!-- Photo preview of exactly the bytes held in the session, with the voice note controls. -->
        <Grid x:Name="PhotoPanel" Grid.Row="1" Visibility="Collapsed" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Image
                x:Name="PhotoImage"
                Grid.Row="0"
                Stretch="Uniform"
                AutomationProperties.Name="Photo preview" />
            <TextBlock
                x:Name="PhotoInfo"
                Grid.Row="1"
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="PhotoInfo" />

            <StackPanel Grid.Row="2" Spacing="8" HorizontalAlignment="Center">
                <!-- No voice note yet. -->
                <Button
                    x:Name="RecordButton"
                    Content="Record voice note"
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="RecordButton"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnRecordClick" />

                <!-- Recording in progress. -->
                <StackPanel x:Name="RecordingPanel" Spacing="8" Visibility="Collapsed" HorizontalAlignment="Center">
                    <TextBlock
                        x:Name="RecordingStatus"
                        HorizontalAlignment="Center"
                        AutomationProperties.AutomationId="RecordingStatus" />
                    <Button
                        x:Name="StopRecordButton"
                        Content="Stop recording"
                        HorizontalAlignment="Center"
                        AutomationProperties.AutomationId="StopRecordButton"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnStopRecordClick" />
                </StackPanel>

                <!-- A voice note is held in the session. -->
                <StackPanel x:Name="VoicePanel" Spacing="8" Visibility="Collapsed" HorizontalAlignment="Center">
                    <TextBlock
                        x:Name="VoiceInfo"
                        HorizontalAlignment="Center"
                        AutomationProperties.AutomationId="VoiceInfo" />
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <Button
                            x:Name="PlayButton"
                            Content="Play"
                            AutomationProperties.AutomationId="PlayButton"
                            Click="OnPlayClick" />
                        <Button
                            x:Name="RerecordButton"
                            Content="Record again"
                            AutomationProperties.AutomationId="RerecordButton"
                            Click="OnRecordClick" />
                        <Button
                            x:Name="DeleteVoiceButton"
                            Content="Discard voice note"
                            AutomationProperties.AutomationId="DeleteVoiceButton"
                            Click="OnDeleteVoiceClick" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <StackPanel
                Grid.Row="3"
                Orientation="Horizontal"
                Spacing="12"
                HorizontalAlignment="Center">
                <!-- Enabled only in ReadyToSave (photo + valid voice note). Saving itself arrives in M6. -->
                <Button
                    x:Name="SaveButton"
                    Content="Save ERAF file"
                    IsEnabled="False"
                    AutomationProperties.AutomationId="SaveButton"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnSaveClick" />
                <Button
                    x:Name="DiscardButton"
                    Content="Start over"
                    AutomationProperties.AutomationId="DiscardButton"
                    Click="OnDiscardClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
